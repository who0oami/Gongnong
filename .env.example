# Gloss conversion provider
# local: Ollama local model (default, no external API quota)
# gemini: legacy Gemini gloss path for comparison/rollback
KSL_GLOSS_PROVIDER=local

# Ollama local LLM
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_GLOSS_MODEL=qwen2.5:3b

# Gemini is still used by the existing subtitle-correction service.
GEMINI_API_KEY=
GEMINI_GLOSS_MODEL=gemini-flash-lite-latest

DATABASE_URL=
# Optional Korean caption font. If unset, common OS font paths are checked.
# KSL_CAPTION_FONT=C:/Windows/Fonts/malgun.ttf
