# 저장소 루트의 .env로 복사한 뒤 로컬에서만 값을 입력합니다.
# 실제 Supabase password, AWS/Gemini key, JWT secret은 절대 커밋하지 않습니다.

# 필수: 공용 Supabase PostgreSQL. 모든 자리표시자를 실제 연결 정보로 교체합니다.
# session pooler 예시이며 사용자명/호스트/포트는 프로젝트 연결 정보를 따릅니다.
# 비밀번호 특수문자는 URL 인코딩합니다. Supabase API URL/anon key가 아닙니다.
DATABASE_URL=postgresql+psycopg://postgres.<PROJECT_REF>:<URL_ENCODED_DB_PASSWORD>@<SUPABASE_SESSION_POOLER_HOST>:5432/postgres?sslmode=require

# 필수: 로컬에서 생성한 충분히 긴 무작위 문자열. 비어 있으면 서버 시작 불가.
JWT_SECRET=

# 현재 Gemini: YouTube 자막 문맥/맞춤법/ASR 오인식 보정 및 Gloss 변환.
# 설정된 키만 JY → GYU → RB → JH 순서로 429 failover에 사용합니다.
GEMINI_API_KEY_JY=
GEMINI_API_KEY_GYU=
GEMINI_API_KEY_RB=
GEMINI_API_KEY_JH=
# 위 네 키가 모두 비어 있을 때만 사용하는 하위 호환 fallback.
GEMINI_API_KEY=

# WORD object key: clips/word/WORDxxxx.mp4
# Job별 임시 디렉터리에 다운로드 → ffprobe/FFmpeg 사용 → 작업 종료 후 삭제.
S3_CLIP_BUCKET=ksl-tube-avatar-clips

# 선택: boto3 기본 AWS 인증 체인. 로컬 CLI 프로필 사용 시 주석을 해제합니다.
# AWS key는 넣지 말고 AWS CLI 프로필/SSO 또는 IAM Role로 관리합니다.
# AWS_PROFILE=ksl-tube
# AWS_DEFAULT_REGION=<ACTUAL_BUCKET_REGION>

# 향후 통합 예정: Ollama/Qwen Local LLM (현재 코드가 읽지 않는 제안 항목)
# jihyun/local-llm-semantic-integration은 아직 이 브랜치에 통합되지 않았습니다.
# 예상 구조: Gemini 자막 교정 → Ollama/Qwen Gloss → WORD → S3 → FFmpeg
# 변수 이름과 모델 태그는 통합 시 확정합니다. 현재는 활성화하지 않습니다.
# OLLAMA_BASE_URL=http://127.0.0.1:11434
# OLLAMA_MODEL=<QWEN_MODEL_TAG>

YOUTUBE_API_KEY=